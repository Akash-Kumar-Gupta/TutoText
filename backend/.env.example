DB_HOST=localhost
DB_PORT=3306
DB_NAME=tutotext_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace_with_your_local_mysql_password
DB_SSL_MODE=DISABLED
# Optional compatibility override for the composed JDBC URL:
# DB_URL=jdbc:mysql://localhost:3306/tutotext_db
# Production: set SPRING_PROFILES_ACTIVE=production, DB_HOST to the Aiven service hostname,
# DB_PORT=22820, DB_NAME=defaultdb, and DB_SSL_MODE=VERIFY_IDENTITY.
# Production truststore: provide the public CA truststore URL/type here; inject
# DB_TRUSTSTORE_PASSWORD separately using the deployment platform's secret manager.
# DB_TRUSTSTORE_URL=file:/run/secrets/aiven-mysql-truststore.jks
# DB_TRUSTSTORE_TYPE=JKS
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key
JWT_SECRET=replace_with_base64_encoded_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=900000
APP_CORS_ALLOWED_ORIGINS=
RATE_LIMIT_REGISTRATION_IP_CAPACITY=5
RATE_LIMIT_REGISTRATION_EMAIL_CAPACITY=3
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_IP_CAPACITY=20
RATE_LIMIT_LOGIN_EMAIL_CAPACITY=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LIVE_TOKEN_IP_CAPACITY=10
RATE_LIMIT_LIVE_TOKEN_ACCOUNT_CAPACITY=5
RATE_LIMIT_LIVE_TOKEN_WINDOW_SECONDS=600
RATE_LIMIT_BUCKET_RETENTION_SECONDS=7200
AUTH_REQUEST_MAX_BYTES=16384
TRANSCRIPTION_REQUEST_MAX_BYTES=17825792
OTHER_API_REQUEST_MAX_BYTES=65536
